 <table border="solid 1px ">
<tr>
    <th>Title</th>
    <th>Description</th>
    <th>Action date</th>
    <th>Todo banner</th>
    <th>User</th>
    <th>Action</th>
</tr>
{{#each data}}
<tr>
    <td>{{this.title}} </td>
    <td>{{this.description}}</td>
    <td>{{this.actionData}}</td>
    {{!-- <td><img src="data:image/jpeg;base64," alt="Error"></td> --}}
    
    <td><img src={{this.todoBanner}}  width="20px"></td>
    <td><button> <i class="fa-regular fa-user"></i></button></li></td>
    <td><button type="button">Edit</button>
    <button type="button" onclick=deleteTodo({{this.id}})>Delete</button></td>
</tr>
{{/each}}
</table>
